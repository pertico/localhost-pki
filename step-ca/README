# Initialize
mkdir -p step/certs step/secrets
pwgen 32 1 > ./.secret

# localhost Smallstep Root CA

step certificate create "localhost Smallstep Root CA" \
    ./certs/root-ca.crt \
    ./secrets/root-ca.key \
    --password-file=./.secret \
    --kty=RSA --size=4096 --not-after=8760h \
    --template ./templates/root-ca.tpl

# localhost Smallstep Intermediate CA

step certificate create "localhost Smallsteo Intermediate CA" \
    ./certs/intermediate-ca.crt \
    ./secrets/intermediate-ca.key \
    --password-file=./.secret \
    --kty=RSA --size=4096 --not-after=4380h \
    --template ./templates/intermediate.tpl \
    --ca ./certs/root-ca.crt --ca-key ./secrets/root-ca.key --ca-password-file=./.secret

# localhost Smallstep Online Intermediate CA

step certificate create "localhost Smallstep Online Intermediate CA" \
    ./certs/step-intermediate-ca.crt \
    ./secrets/step-intermediate-ca.key \
    --password-file=./.secret \
    --kty=RSA --size=4096 --not-after=2190h \
    --template ./templates/intermediate-2.tpl \
    --ca ./certs/intermediate-ca.crt --ca-key ./secrets/intermediate-ca.key --ca-password-file=./.secret

step certificate bundle ./certs/step-intermediate-ca.crt ./certs/intermediate-ca.crt ./certs/step-ca-bundle.crt

# step-ca init

step ca init \
    --deployment-type=standalone \
    --name="localhost smallstep Online CA" \
    --dns="ca.localhost,localhost,127.0.0.1" \
    --address="127.0.0.1:8443" \
    --provisioner="me@localhost" \
    --acme \
    --root=./certs/intermediate-ca.crt \
    --key=./secrets/intermediate-ca.key \
    --key-password-file=./.secret \
    --password-file=./.secret \
    --provisioner-password-file=./.secret

cp ./certs/root-ca.crt $(step path)/certs/root_ca.crt
cp ./certs/step-ca-bundle.crt $(step path)/certs/intermediate_ca.crt
cp ./secrets/step-intermediate-ca.key $(step path)/secrets/intermediate_ca_key

step ca provisioner update 'me@localhost' --x509-default-dur 336h
step ca provisioner update 'acme' --x509-default-dur 168h