# Root + Intermediate CA

openssl genrsa -out localhost_openssl_Root_CA.key 4096
openssl req -x509 -new -nodes \
  -key localhost_openssl_Root_CA.key \
  -sha256 -days 365 \
  -subj "/CN=localhost openssl Root CA" \
  -addext "basicConstraints=critical,CA:TRUE" \
  -addext "keyUsage=critical,keyCertSign,cRLSign" \
  -out localhost_openssl_Root_CA.crt

openssl genrsa -out "localhost_openssl_Intermediate_CA".key 4096
openssl req -new \
  -key localhost_openssl_Intermediate_CA.key \
  -subj "/CN=localhost openssl Intermediate CA" \
  -out localhost_openssl_Intermediate_CA.csr
openssl x509 -req \
  -in localhost_openssl_Intermediate_CA.csr \
  -CA localhost_openssl_Root_CA.crt \
  -CAkey localhost_openssl_Root_CA.key \
  -CAcreateserial \
  -days 180 -sha256 \
  -extfile ../intermediate.ext \
  -out localhost_openssl_Intermediate_CA.crt

openssl genrsa -out "localhost_openssl_WEB_Intermediate_CA".key 4096
openssl req -new \
  -key localhost_openssl_WEB_Intermediate_CA.key \
  -subj "/CN=localhost openssl WEB Intermediate CA" \
  -out localhost_openssl_WEB_Intermediate_CA.csr
openssl x509 -req \
  -in localhost_openssl_Intermediate_CA.csr \
  -CA localhost_openssl_Root_CA.crt \
  -CAkey localhost_openssl_Root_CA.key \
  -CAcreateserial \
  -days 90 -sha256 \
  -extfile ../intermediate-2.ext \
  -out localhost_openssl_WEB_Intermediate_CA.crt


# --------------------------------------
#  Root CA
mkdir -p ./rootca/{certs,crl,newcerts,private}
chmod 700 ./rootca/private
touch ./rootca/index.txt
echo 1000 > ./rootca/serial

#openssl genrsa -aes256 -out ./rootca/private/rootca.key 4096
openssl genrsa -out ./rootca/private/rootca.key 4096
chmod 400 ./rootca/private/rootca.key

openssl req -config ./ca.conf \
      -key ./rootca/private/rootca.key \
      -new -x509 -days 365 -sha256 -extensions v3_root_ca \
      -out ./rootca/certs/rootca.crt \
      -subj "/CN=localhost openssl Root CA"

openssl x509 -noout -text -in ./rootca/certs/rootca.crt

# localhost openssl Intermediate CA
mkdir -p ./intermediate/{certs,crl,csr,newcerts,private}
chmod 700 ./intermediate/private
touch ./intermediate/index.txt
echo 1000 > ./intermediate/serial
echo 1000 > ./intermediate/crlnumber

# openssl genrsa -aes256 -out ./intermediate/private/intermediate.key 4096
openssl genrsa -out ./intermediate/private/intermediate.key 4096
chmod 400 ./intermediate/private/intermediate.key

openssl req -config ./ca.conf -new -sha256 \
      -key ./intermediate/private/intermediate.key \
      -out ./intermediate/csr/intermediate.csr \
      -subj "/CN=localhost openssl Intermediate CA"

openssl ca -config ./ca.conf -name root_ca \
      -extensions v3_intermediate_ca \
      -days 365 -notext -md sha256 \
      -in ./intermediate/csr/intermediate.csr \
      -out ./intermediate/certs/intermediate.crt
chmod 444 ./intermediate/certs/intermediate.crt

openssl verify -CAfile ./rootca/certs/rootca.crt \
      ./intermediate/certs/intermediate.crt

# WEB Intermediate CA
mkdir -p ./subca_web/{certs,crl,csr,newcerts,private}
chmod 700 ./subca_web/private
touch ./subca_web/index.txt
echo 1000 > ./subca_web/serial
echo 1000 > ./subca_web/crlnumber

openssl genrsa -out ./subca_web/private/subca_web.key 4096
chmod 400 ./subca_web/private/subca_web.key

openssl req -config ./ca.conf -new -sha256 \
      -key ./subca_web/private/subca_web.key \
      -out ./subca_web/csr/subca_web.csr \
      -subj "/CN=localhost openssl WEB Intermediate CA"

openssl ca -config ./ca.conf -name intermediate_ca \
      -extensions v3_sub_ca \
      -days 180 -notext -md sha256 \
      -in ./subca_web/csr/subca_web.csr \
      -out ./subca_web/certs/subca_web.crt
chmod 444 ./subca_web/certs/subca_web.crt

# Crear la cadena intermedia temporal para validación
cat ./rootca/certs/rootca.crt ./intermediate/certs/intermediate.crt > /tmp/chain_test.crt
openssl verify -CAfile /tmp/chain_test.crt ./subca_web/certs/subca_web.crt
rm /tmp/chain_test.crt

# Wildcard localhost

openssl genrsa -out ./subca_web/private/localhost.key 4096
chmod 400 ./subca_web/private/localhost.key

openssl req -config ./ca.conf -new -sha256 \
      -key ./subca_web/private/localhost.key \
      -subj "/CN=localhost" \
      -out ./subca_web/csr/server.csr

openssl ca -config ./ca.conf \
      -name sub_ca_web \
      -extensions server_san_cert \
      -days 30 -notext -md sha256 \
      -in ./subca_web/csr/server.csr \
      -out ./subca_web/certs/server.crt
chmod 444 ./subca_web/certs/server.crt