# localhost CFSSL Root CA
    
    cfssl gencert -initca ./config/ca-csr.json | cfssljson -bare out/root-ca

# localhost CFSSL Intermediate CA

    cfssl genkey ./config/intermediate-csr.json | cfssljson -bare out/intermediate-ca && \
    cfssl sign -ca out/root-ca.pem -ca-key out/root-ca-key.pem -config ./config/ca-config.json -profile intermediate out/intermediate-ca.csr | cfssljson -bare out/intermediate-ca
    
# localhost CFSSL Smallstep Intermediate CA
    
        cfssl genkey ./config/step-intermediate-csr.json | cfssljson -bare out/step-intermediate-ca
        cfssl sign -ca intermediate-ca.pem -ca-key intermediate-ca-key.pem -config ./config/ca-config.json -profile intermediate-2 step-intermediate-ca.csr | cfssljson -bare out/step-intermediate-ca

# localhost CFSSL Caddy Intermediate CA  

        cfssl genkey ./config/caddy-intermediate-csr.json | cfssljson -bare out/caddy-intermediate-ca
        cfssl sign -ca intermediate-ca.pem -ca-key intermediate-ca-key.pem -config ./config/ca-config.json -profile intermediate-2 caddy-intermediate-ca.csr | cfssljson -bare out/caddy-intermediate-ca
