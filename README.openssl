# Simple Root + Intermediate CA

``` shell
openssl genrsa -out root-ca/private/localhost_Root_CA.key 4096 && \
openssl req -x509 -new -nodes \
  -key root-ca/private/localhost_Root_CA.key \
  -sha256 -days 365 \
  -subj "/CN=localhost Root CA" \
  -addext "basicConstraints=critical,CA:TRUE" \
  -addext "keyUsage=critical,keyCertSign,cRLSign" \
  -out root-ca/certs/localhost_Root_CA.crt
```

``` shell
openssl genrsa -out intermediate-ca/private/localhost_Intermediate_CA.key 4096 && \
openssl req -new \
  -key intermediate-ca/private/localhost_Intermediate_CA.key \
  -subj "/CN=localhost Intermediate CA" \
  -out root-ca/csr/localhost_Intermediate_CA.csr && \
openssl x509 -req \
  -in root-ca/csr/localhost_openssl_Intermediate_CA.csr \
  -CA root-ca/certslocalhost_Root_CA.crt \
  -CAkey localhost_openssl_Root_CA.key \
  -CAcreateserial \
  -days 180 -sha256 \
  -extfile ../intermediate.ext \
  -out localhost_openssl_Intermediate_CA.crt
```

# Complete Root + Intermediate
``` shell
mkdir -p ./root-ca/{certs,csr,crl,newcerts,private}
chmod 700 ./root-ca/private
touch ./root-ca/index.txt
echo 1000 > ./root-ca/serial
```

``` shell
# openssl genrsa -aes256 -out ./rootca/private/rootca.key 4096
openssl genrsa -out ./root-ca/private/rootca.key 4096 && \
chmod 400 ./root-ca/private/rootca.key
```

``` shell
openssl req -config ./ca.conf \
      -key ./rootca/private/rootca.key \
      -new -x509 -days 365 -sha256 -extensions v3_root_ca \
      -out ./rootca/certs/rootca.crt \
      -subj "/CN=localhost openssl Root CA"

openssl x509 -noout -text -in ./rootca/certs/rootca.crt

# localhost openssl Intermediate CA
mkdir -p ./intermediate/{certs,crl,csr,newcerts,private}
chmod 700 ./intermediate/private
touch ./intermediate/index.txt
echo 1000 > ./intermediate/serial
echo 1000 > ./intermediate/crlnumber

# openssl genrsa -aes256 -out ./intermediate/private/intermediate.key 4096
openssl genrsa -out ./intermediate/private/intermediate.key 4096
chmod 400 ./intermediate/private/intermediate.key

openssl req -config ./ca.conf -new -sha256 \
      -key ./intermediate/private/intermediate.key \
      -out ./rootca/csr/intermediate.csr \
      -subj "/CN=localhost openssl Intermediate CA"

openssl ca -config ./ca.conf -name root_ca \
      -extensions v3_intermediate_ca \
      -days 365 -notext -md sha256 \
      -in ./rootca/csr/intermediate.csr \
      -out ./rootca/certs/intermediate.crt
chmod 444 ./rootca/certs/intermediate.crt
cp ./rootca/certs/intermediate.crt ./intermediate/certs/

openssl verify -CAfile ./rootca/certs/rootca.crt \
      ./intermediate/certs/intermediate.crt

# Wildcard localhost
openssl genrsa -out ./intermediate/private/localhost.key 4096
chmod 400 ./intermediate/private/localhost.key

openssl req -config ./ca.conf -new -sha256 \
      -key ./intermediate/private/localhost.key \
      -subj "/CN=localhost" \
      -out ./intermediate/csr/localhost.csr

openssl ca -config ./ca.conf \
      -name intermediate_ca \
      -extensions server_san_cert \
      -days 30 -notext -md sha256 \
      -in ./intermediate/csr/localhost.csr \
      -out ./intermediate/certs/localhost.crt
chmod 444 ./intermediate/certs/localhost.crt
