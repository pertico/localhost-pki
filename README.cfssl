# localhost CFSSL Root CA
    
    cfssl gencert -initca ./config/ca-csr.json | cfssljson -bare out/root-ca

# localhost CFSSL Intermediate CA

    cfssl genkey ./config/intermediate-csr.json | cfssljson -bare out/intermediate-ca && \
    cfssl sign -ca out/root-ca.pem -ca-key out/root-ca-key.pem -config ./config/ca-config.json -profile intermediate out/intermediate-ca.csr | cfssljson -bare out/intermediate-ca

# localhost CFSSL WEB Intermediate CA
    
    cfssl genkey ./config/web-intermediate-csr.json | cfssljson -bare out/web-intermediate-ca && \
    cfssl sign -ca out/intermediate-ca.pem -ca-key out/intermediate-ca-key.pem -config ./config/ca-config.json -profile intermediate-2 out/web-intermediate-ca.csr | cfssljson -bare out/web-intermediate-ca

# localhost CFSSL Smallstep Intermediate CA
    
    cfssl genkey ./config/step-intermediate-csr.json | cfssljson -bare out/step-intermediate-ca && \
    cfssl sign -ca out/intermediate-ca.pem -ca-key out/intermediate-ca-key.pem -config ./config/ca-config.json -profile intermediate-2 out/step-intermediate-ca.csr | cfssljson -bare out/step-intermediate-ca

# localhost CFSSL Caddy Intermediate CA  

    cfssl genkey ./config/caddy-intermediate-csr.json | cfssljson -bare out/caddy-intermediate-ca && \
    cfssl sign -ca out/intermediate-ca.pem -ca-key out/intermediate-ca-key.pem -config ./config/ca-config.json -profile intermediate-2 out/caddy-intermediate-ca.csr | cfssljson -bare out/caddy-intermediate-ca

# localhost

    cfssl genkey ./config/localhost-csr.json | cfssljson -bare out/localhost && \
    cfssl sign -ca out/web-intermediate-ca.pem -ca-key out/web-intermediate-ca-key.pem -config ./config/ca-config.json -profile server out/localhost.csr | cfssljson -bare out/localhost